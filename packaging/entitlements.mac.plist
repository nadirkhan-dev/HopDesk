<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code at run time, which the
       hardened runtime forbids unless it is asked for. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- koffi loads its native module, and libraries it did not sign (the system
       frameworks it binds). Without this, loading Quartz fails on a notarised
       build and input injection silently does nothing. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Reaching another computer, and being reachable, over the network. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
