# Copy to .env and fill in. Keep .env private: it holds two secrets.

# The domain that points at this server. Caddy gets a certificate for it.
HOPDESK_DOMAIN=hopdesk.example.com
# Where certificate problems are sent.
HOPDESK_ACME_EMAIL=you@example.com

# Signs access tokens. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
HOPDESK_TOKEN_SECRET=

# Who may create an account.
#
# Normally: a registration token, set here, which you give to whoever should
# have an account. Without it nobody can register — including whoever finds the
# server before you do. Generate one with: openssl rand -base64 24
HOPDESK_REGISTRATION_TOKEN=

# Set this to true only if you want anyone who can reach the server to be able
# to sign up. It overrides the token.
HOPDESK_REGISTRATION_OPEN=false

# The relay. Generate with: openssl rand -base64 32
HOPDESK_TURN_SECRET=
# What clients are told to use. Use your domain, and turns: as well if you add
# certificates to coturn.
HOPDESK_TURN_URLS=turn:hopdesk.example.com:3478
# This machine's public IP address, which coturn hands out as the relay address.
HOPDESK_PUBLIC_IP=

# Optional: a STUN server for finding a direct path first. Point it at your own
# coturn (stun:hopdesk.example.com:3478) to depend on nobody else.
HOPDESK_STUN_URLS=stun:stun.l.google.com:19302
